__pycache__

# Multi-account runtime state (see claude --setup):
#   accounts.json  — user-specific account map (emails, dirs); sensitive
#   .this_claude   — active-account marker, flips on every --setup
accounts.json
.this_claude

# Fork-sync config (see forks.example.json for the schema). Holds local repo
# paths and branch names that don't generalize across users.
forks.json

# GSD per-task scratch dir (.planning/PHASE.md, REVIEW.md, etc.) — task-scoped,
# not versioned with the wrapper.
.planning/
