def _agent_fastpath(args):
    """When invoked as a subagent (--agent-id in argv), skip tmux orchestration.

    Claude Code's NeK() resolver reads CLAUDE_CODE_TEAMMATE_COMMAND FIRST to
    choose the teammate spawn binary. On the outer launch we set that env var
    to this wrapper's canonical path, so every subagent spawn re-enters this
    script with `--agent-id …` in argv. We strip `--model <value>` (otherwise
    the subagent caps at 200K instead of defaulting to the 1M variant), then
    exec the real claude ELF via ~/.local/bin/claude.
    """
    if "--agent-id" not in args:
        return
    stripped = []
    skip_next = False
    for a in args:
        if skip_next:
            skip_next = False
            continue
        if a == "--model":
            skip_next = True
            continue
        stripped.append(a)
    os.execv(REAL_CLAUDE, [REAL_CLAUDE] + stripped)


def get_workspace_hash(pwd: str) -> str:
    """Generate short hash from workspace path."""
    return hashlib.md5(pwd.encode()).hexdigest()[:8]


def load_state() -> dict:
    """Load session state from file."""
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except (json.JSONDecodeError, IOError):
            return {"sessions": {}}
    return {"sessions": {}}


def save_state(state: dict):
    """Save session state to file."""
    STATE_FILE.write_text(json.dumps(state, indent=2))


def get_tmux_sessions() -> dict:
    """Get all tmux sessions with their status."""
    result = subprocess.run(
        ["tmux", "ls", "-F", "#{session_name}|#{session_attached}|#{session_created}"],
        capture_output=True,
        text=True
    )
    
    sessions = {}
    if result.returncode == 0:
        for line in result.stdout.strip().split("\n"):
            if line and line.startswith(SESSION_PREFIX):
                parts = line.split("|")
                if len(parts) >= 2:
                    name = parts[0]
                    attached = parts[1] == "1"
                    created = parts[2] if len(parts) > 2 else ""
                    sessions[name] = {
                        "attached": attached,
                        "created": created
                    }
    return sessions


def get_sessions_for_workspace(pwd: str) -> list:
    """Get all sessions matching current workspace."""
    workspace_hash = get_workspace_hash(pwd)
    tmux_sessions = get_tmux_sessions()
    state = load_state()
    
    matching = []
    for name, info in tmux_sessions.items():
        # Check if session belongs to this workspace
        if f"-{workspace_hash}-" in name:
            session_state = state.get("sessions", {}).get(name, {})
            matching.append({
                "name": name,
                "attached": info["attached"],
                "created": info["created"],
                "pwd": session_state.get("pwd", pwd)
            })
    
    return sorted(matching, key=lambda x: x["name"])


def create_new_session(pwd: str) -> str:
    """Create a new tmux session name."""
    workspace_hash = get_workspace_hash(pwd)
    
    # Find next available number
    existing = get_tmux_sessions()
    n = 1
    while f"{SESSION_PREFIX}-{workspace_hash}-{n}" in existing:
        n += 1
    
    session_name = f"{SESSION_PREFIX}-{workspace_hash}-{n}"
    
    # Record in state
    state = load_state()
    state["sessions"][session_name] = {
        "pwd": pwd,
        "created": datetime.now().isoformat()
    }
    save_state(state)
    
    return session_name


def remove_session_from_state(session_name: str):
    """Remove a session from our state file."""
    state = load_state()
    if session_name in state.get("sessions", {}):
        del state["sessions"][session_name]
        save_state(state)


def kill_session(session_name: str):
    """Kill a tmux session."""
    subprocess.run(["tmux", "kill-session", "-t", session_name], capture_output=True)
    remove_session_from_state(session_name)


def attach_session(session_name: str, show_detach_hint: bool = False):
    """Attach to an existing tmux session."""
    if show_detach_hint:
        print("\033[90mTip: Press Ctrl-b d to detach (leaves session running)\033[0m\n")
    # Reload tmux config so any changes apply to this session
    tmux_conf = Path.home() / ".tmux.conf"
    if tmux_conf.exists():
        subprocess.run(["tmux", "source-file", str(tmux_conf)], capture_output=True)

    # Ensure pane-died hook is set (may not exist for older sessions)
    output_file = f"/tmp/claude-tmux-{session_name}.txt"
    subprocess.run([
        "tmux", "set-hook", "-t", session_name, "pane-died",
        f'run-shell "capture-pane -p -S -30 > {output_file}"'
    ], capture_output=True)
    # Attach and track timing
    start_time = time.time()
    subprocess.run(["tmux", "attach", "-t", session_name])
    elapsed = time.time() - start_time

    # If session exited within 10 seconds, show captured output
    if elapsed < 10 and os.path.exists(output_file):
        try:
            content = Path(output_file).read_text().strip()
            if content:
                print("\n\033[1;31m━━━ Session exited quickly. Last output: ━━━\033[0m\n")
                print(content)
                print("\n\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m")
        except IOError:
            pass
    # Clean up temp file
    if os.path.exists(output_file):
        os.remove(output_file)


def start_new_session(session_name: str, args: list):
    """Start a new tmux session with claude (dumb terminal mode)."""
    # Prepend any flags from CLAUDE_TMUX_FLAGS (reads tmux global env if inside tmux)
    env_flags = get_claude_tmux_flags().split()
    all_args = env_flags + args
    # Inline env prefix: scopes vars to this single claude process (not tmux-wide).
    # Subagents inherit them via os.execv in _agent_fastpath.
    env_prefix = ""
    pct_val = os.environ.get("CLAUDE_AUTOCOMPACT_PCT_OVERRIDE")
    if pct_val:
        env_prefix = f"CLAUDE_AUTOCOMPACT_PCT_OVERRIDE={pct_val} "
    cmd = env_prefix + " ".join([REAL_CLAUDE] + all_args)
    cmd = f"echo '[claude-tmux] {cmd}'; {cmd}"

    # Create detached session with the command
    # Claude Code 2.1+ handles scrollback correctly via its own scroll-region
    # rendering (input pinned to bottom, output scrolls cleanly), so CI=true
    # is no longer needed and was actively harmful: it suppressed Claude
    # Code's mouse reporting, which broke the native (blue) selection
    # highlight inside tmux. FORCE_COLOR=1 is kept as a harmless belt-and-braces.

    subprocess.run([
        "tmux", "new-session", "-d", "-s", session_name,
        "-e", "FORCE_COLOR=1",
        "-e", f"CLAUDE_CODE_TEAMMATE_COMMAND={SELF_PATH}",
        cmd
    ], check=True)

    # Disable smcup/rmcup to prevent alternate screen buffer issues
    subprocess.run(["tmux", "set", "-g", "terminal-overrides", "*:smcup@:rmcup@"])



    #------------------------------------------------------------------
    # support for showing last history buffer if it exists straight away 
    #------------------------------------------------------------------

    # Capture last 30 lines to temp file when pane dies (for crash diagnostics)
    output_file = f"/tmp/claude-tmux-{session_name}.txt"
    subprocess.run([
        "tmux", "set-hook", "-t", session_name, "pane-died",
        f'run-shell "capture-pane -p -S -30 > {output_file}"'
    ])


    # Attach and track timing for quick-exit detection
    start_time = time.time()
    subprocess.run(["tmux", "attach", "-t", session_name])
    elapsed = time.time() - start_time

    # If session exited within 10 seconds, show captured output
    if elapsed < 10 and os.path.exists(output_file):
        try:
            content = Path(output_file).read_text().strip()
            if content:
                print("\n\033[1;31m━━━ Session exited quickly. Last output: ━━━\033[0m\n")
                print(content)
                print("\n\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m")
        except IOError:
            pass
    # Clean up temp file
    if os.path.exists(output_file):
        os.remove(output_file)

