    CLAUDE_SKIP_SKILL_SYNC=1           Skip the automatic skill-repo sync on outer launch
    CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=N  Auto-compact threshold as % of context window (1-95)

\033[1mEXAMPLES:\033[0m
    claude                    Interactive menu for current workspace
    claude --list-all         Show all sessions with numbers
    claude --attach 2         Attach to session #2 from list
    claude -- --resume        Start claude with --resume flag (auto-compact on @60%)
    claude --compact=80 -- --resume   Override auto-compact to 80% (~800K of 1M)
    claude --no-compact -- --resume   Disable wrapper's auto-compact override
    claude --kill 2           Kill session #2 from list
    claude --sync-forks       Sync plugin forks with upstream right now
    claude --sync-skills      Pull upstream-only skill repos right now
""")


def main():
    pwd = os.getcwd()
    args = sys.argv[1:]  # Pass through any arguments to claude

    # Subagent fast-path: re-entered via CLAUDE_CODE_TEAMMATE_COMMAND. Strip
    # --model and exec the real claude so the subagent gets 1M context.
    _agent_fastpath(args)

    # Outer launches: force subagent spawns back through this wrapper so the
    # --model strip happens. Inherited into child claude's env.
    os.environ["CLAUDE_CODE_TEAMMATE_COMMAND"] = SELF_PATH

    # Multi-account routing.
    #   --setup <name>      Switch active account (migrates on first run). Exits.
    #   --setup (no arg)    List accounts.
    #   otherwise           Assert the active slice's symlinks are correct, then
    #                       continue the normal launch flow.
    accounts_cfg = load_accounts_config()
    if args and args[0] == "--setup":
        if len(args) < 2:
            print_setup_usage(accounts_cfg)
            sys.exit(0)
        setup_account(accounts_cfg, args[1])
        sys.exit(0)

    active = get_active_account(accounts_cfg)
    try:
        ensure_account_state(accounts_cfg, active)
    except RuntimeError as e:
        print(f"\033[31m[claude-tmux] {e}\033[0m", file=sys.stderr)
        sys.exit(1)
    # Banner on outer launches only (keeps inside-tmux re-entries quiet).
    if not os.environ.get("TMUX"):
        email = accounts_cfg["accounts"][active].get("email", "")
        print(f"\033[90m[claude-tmux] Active account: {active} ({email})\033[0m")

    # Sync CLAUDE_TMUX_FLAGS into tmux's global environment so that
    # inside-tmux invocations don't get a stale cached value
    if not os.environ.get("TMUX"):
        sync_tmux_flags_to_server()
        # Sync locally-installed plugin forks against their upstreams once
        # per outer launch. Skipped automatically when already inside tmux or
        # when CLAUDE_SKIP_FORK_SYNC is set.
        sync_fork_repos()
        # Same idea for upstream-only skill repos (symlinked into ~/.claude/skills).
        # Skipped when CLAUDE_SKIP_SKILL_SYNC is set.
        sync_skill_repos()
        # Neutralize ECC's fact-forcing gate on every outer launch so it
        # survives plugin updates. Silent when ECC isn't installed.
        neutralize_gateguard()

    # Auto-compact is ON by default — we set CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=60
    # (compact at ~60% used = ~600K of a 1M window) unless:
    #   - user passed --no-compact (opt out entirely for this launch)
    #   - user passed --compact=PCT (explicit value, 1-95)
    #   - env var is already set (user shell override wins)
    # Bare --compact is still accepted as a redundant-but-harmless no-op for
    # any scripts that already pass it.
    # Strip these wrapper-only flags from args BEFORE the -- split so they
    # never reach the real claude binary.
    # Note: CLAUDE_CODE_AUTO_COMPACT_WINDOW is a SEPARATE knob that *shrinks*
    # the capacity used in compaction math — using it as a "buffer reserve"
    # backfires (e.g. 400000 on 1M caps the usable window at 400K, then PCT
    # default ~95% fires compact at ~38% of the real window).
    compact_filtered = []
    compact_value = "60"
    disable_compact = False
    for a in args:
        if a == "--no-compact":
            disable_compact = True
            continue
        if a == "--compact" or a.startswith("--compact="):
            if "=" in a:
                compact_value = a.split("=", 1)[1]
            continue
        compact_filtered.append(a)
    args = compact_filtered

    # 2026-05-14: disabled — CLAUDE_AUTOCOMPACT_PCT_OVERRIDE behaviour is broken
    # upstream (interactions with AUTO_COMPACT_WINDOW caused premature firing).
    # Parser above still strips --compact / --no-compact so callers don't break,
    # but we no longer set the env var. Re-enable here when the upstream knob
    # is fixed, or remove the parser block too if we don't plan to come back.
    # if not disable_compact and not os.environ.get("CLAUDE_AUTOCOMPACT_PCT_OVERRIDE"):
    #     os.environ["CLAUDE_AUTOCOMPACT_PCT_OVERRIDE"] = compact_value

    # Handle -- separator: args after -- are for claude, not for this wrapper
    if "--" in args:
        sep_idx = args.index("--")
        wrapper_args = args[:sep_idx]
        claude_args = args[sep_idx + 1:]  # Skip the -- itself
    else:
        wrapper_args = args
        claude_args = args

    # Check for --help flag
    if wrapper_args and wrapper_args[0] in ("--help", "-h"):
        print_help()
        sys.exit(0)

    # Check for --sync-forks flag: manual one-shot sync of configured plugin forks
    if wrapper_args and wrapper_args[0] == "--sync-forks":
        sync_fork_repos()
        sys.exit(0)

    # Check for --sync-skills flag: manual one-shot sync of upstream-only skill repos
    if wrapper_args and wrapper_args[0] == "--sync-skills":
        sync_skill_repos()
        sys.exit(0)

    # Check for --list flag
    if wrapper_args and wrapper_args[0] == "--list":
        sessions = get_sessions_for_workspace(pwd)
        print_menu(sessions, pwd)
        sys.exit(0)

    # Check for --list-all flag
    if wrapper_args and wrapper_args[0] == "--list-all":
        sessions = get_all_sessions_list()
        print("\n\033[1mAll Claude Code sessions:\033[0m\n")
        if not sessions:
            print("  \033[90mNo sessions found.\033[0m")
        else:
            # Group by path
            by_path = {}
            for i, s in enumerate(sessions, 1):
                path = s["pwd"]
                if path not in by_path:
                    by_path[path] = []
                by_path[path].append((i, s))

            for path in sorted(by_path.keys()):
                print(f"  \033[1;36m{path}\033[0m")
                for i, s in by_path[path]:
                    if s["attached"]:
                        status = "\033[90m[IN USE]\033[0m"
                    else:
                        status = "\033[1;32m[AVAILABLE]\033[0m"
                    print(f"    \033[1;32m{i})\033[0m {s['name']} {status}")
                print()
        sys.exit(0)

    # Check for --attach flag
    if wrapper_args and wrapper_args[0] == "--attach":
        if len(wrapper_args) < 2:
            print("\033[31mError: --attach requires a session number\033[0m")
            print("Use --list-all to see available sessions")
            sys.exit(1)
        try:
            idx = int(wrapper_args[1]) - 1
            sessions = get_all_sessions_list()
            if idx < 0 or idx >= len(sessions):
                print(f"\033[31mError: Invalid session number {wrapper_args[1]}\033[0m")
                print(f"Valid range: 1-{len(sessions)}")
                sys.exit(1)
            session = sessions[idx]
            if session["attached"]:
                print(f"\033[33mWarning: Session is already attached elsewhere\033[0m")
            # Change to the session's working directory before attaching
            session_pwd = session["pwd"]
            if session_pwd != "unknown" and os.path.isdir(session_pwd):
                os.chdir(session_pwd)
            attach_session(session["name"], show_detach_hint=True)
        except ValueError:
            print(f"\033[31mError: '{wrapper_args[1]}' is not a valid number\033[0m")
            sys.exit(1)


    # Check for --kill flag
    if wrapper_args and wrapper_args[0] == "--kill":
        if len(wrapper_args) < 2:
            print("\033[31mError: --kill requires a session number\033[0m")
            print("Use --list-all to see available sessions")
            sys.exit(1)
        try:
            idx = int(wrapper_args[1]) - 1
            sessions = get_all_sessions_list()
            if idx < 0 or idx >= len(sessions):
                print(f"\033[31mError: Invalid session number {wrapper_args[1]}\033[0m")
                print(f"Valid range: 1-{len(sessions)}")
                sys.exit(1)
            session = sessions[idx]
            kill_session(session["name"])
            print(f"\033[31mKilled {session['name']}\033[0m")
            sys.exit(0)
        except ValueError:
            print(f"\033[31mError: '{wrapper_args[1]}' is not a valid number\033[0m")
            sys.exit(1)

    # Check for --kill-orphans flag
    if wrapper_args and wrapper_args[0] == "--kill-orphans":
        # Kill detached sessions not in current workspace
        all_sessions = get_tmux_sessions()
        killed = 0
        for name, info in all_sessions.items():
            if not info["attached"]:
                kill_session(name)
                print(f"Killed: {name}")
                killed += 1
        print(f"\nKilled {killed} orphaned sessions.")
        sys.exit(0)

    # Already inside tmux? Run claude directly (no nesting).
    # This handles the VS Code terminal profile case where tmux is the default
    # shell (via "tmux new -ADs ${PWD##*/}" in settings.json). The outer tmux
    # already provides crash protection, so we skip session management and exec.
    if os.environ.get("TMUX"):
        env_flags = get_claude_tmux_flags().split()
        all_args = env_flags + claude_args
        print("\033[90mAlready in tmux — running claude directly.\033[0m")
        print(str([REAL_CLAUDE] + all_args))
        os.execvp(REAL_CLAUDE, [REAL_CLAUDE] + all_args)

    interactive_menu(pwd, claude_args)


if __name__ == "__main__":
    main()
