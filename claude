#!/usr/bin/env python3
"""
claude-wrapper: Smart tmux wrapper for Claude Code
Manages persistent Claude Code sessions across VS Code disconnections.

Requires: tmux 3.6a or later
"""

import subprocess
import os
import sys
import hashlib
import json
import time
from pathlib import Path
from datetime import datetime

# Config
REAL_CLAUDE = str(Path.home() / ".local/bin/claude")
STATE_FILE = Path.home() / ".claude-sessions.json"
SESSION_PREFIX = "cc"
SELF_PATH = str(Path(__file__).resolve())

# Fork repos that back locally-installed Claude Code plugins.
# On outer launch we fetch upstream, merge into the tracking branch, and push
# to origin so Claude's own periodic plugin "update" pulls the merged result.
# Add more entries (e.g. gsd) when/if you want them auto-synced too.
FORK_SYNC_REPOS = [
    {
        "name": "superpowers",
        "path": Path.home() / "path/to/your/skills-and-mcp/superpowers",
        "branch": "your-feature-branch",
        "upstream_remote": "upstream",
        "upstream_branch": "main",
        "origin_remote": "origin",
    },
]

def get_claude_tmux_flags() -> str:
    """Get CLAUDE_TMUX_FLAGS, preferring tmux global env when inside tmux.

    The tmux server caches its environment at startup. Shells inside tmux
    inherit this stale snapshot. To work around this, outer invocations
    sync the current value into tmux's global environment, and inner
    invocations read it back from there.
    """
    if os.environ.get("TMUX"):
        result = subprocess.run(
            ["tmux", "show-environment", "-g", "CLAUDE_TMUX_FLAGS"],
            capture_output=True, text=True
        )
        if result.returncode == 0:
            line = result.stdout.strip()
            if "=" in line:
                return line.split("=", 1)[1]
    return os.environ.get("CLAUDE_TMUX_FLAGS", "")


def sync_tmux_flags_to_server():
    """Push current CLAUDE_TMUX_FLAGS into tmux's global environment.

    Called when running outside tmux so that future inside-tmux
    invocations read the up-to-date value via get_claude_tmux_flags().
    """
    val = os.environ.get("CLAUDE_TMUX_FLAGS", "")
    if val:
        subprocess.run(
            ["tmux", "set-environment", "-g", "CLAUDE_TMUX_FLAGS", val],
            capture_output=True
        )
    else:
        # Unset so stale values don't linger
        subprocess.run(
            ["tmux", "set-environment", "-g", "-u", "CLAUDE_TMUX_FLAGS"],
            capture_output=True
        )


def _run_git(path, args, timeout=30):
    """Run git subcommand in repo at `path`. Returns CompletedProcess or None on error."""
    try:
        return subprocess.run(
            ["git", "-C", str(path)] + list(args),
            capture_output=True, text=True, timeout=timeout
        )
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return None


def sync_one_fork(cfg) -> str:
    """Fetch upstream, merge into tracking branch, push to origin. Safe to skip on any problem.

    Returns a one-line status string (already ANSI-coloured) for the caller to print.
    """
    name = cfg["name"]
    path = cfg["path"]
    branch = cfg["branch"]
    upstream_ref = f"{cfg['upstream_remote']}/{cfg['upstream_branch']}"

    if not path.exists() or not (path / ".git").exists():
        return f"  \033[90m⤳ {name}: not a git repo at {path}, skipping\033[0m"

    # Bail cleanly if there's anything uncommitted — don't interfere with user's work
    status = _run_git(path, ["status", "--porcelain"])
    if status is None or status.returncode != 0:
        return f"  \033[31m⤳ {name}: git status failed, skipping\033[0m"
    if status.stdout.strip():
        return f"  \033[33m⤳ {name}: uncommitted changes, skipping\033[0m"

    # Only sync when actually on the tracking branch
    current = _run_git(path, ["rev-parse", "--abbrev-ref", "HEAD"])
    if current is None or current.returncode != 0:
        return f"  \033[31m⤳ {name}: cannot read current branch, skipping\033[0m"
    current_branch = current.stdout.strip()
    if current_branch != branch:
        return f"  \033[33m⤳ {name}: on '{current_branch}' (expected '{branch}'), skipping\033[0m"

    # Fetch upstream (may fail on network — don't block)
    fetch = _run_git(path, ["fetch", cfg["upstream_remote"], "--quiet", "--prune"])
    if fetch is None or fetch.returncode != 0:
        return f"  \033[33m⤳ {name}: fetch upstream failed (offline?), skipping\033[0m"

    behind = _run_git(path, ["rev-list", "--count", f"HEAD..{upstream_ref}"])
    if behind is None or behind.returncode != 0:
        return f"  \033[31m⤳ {name}: cannot compare with {upstream_ref}, skipping\033[0m"
    behind_n = int(behind.stdout.strip() or "0")

    if behind_n == 0:
        return f"  \033[32m✓ {name}: up to date with {upstream_ref}\033[0m"

    # Merge upstream — abort cleanly on conflict
    merge = _run_git(path, ["merge", upstream_ref, "--no-edit", "--quiet"])
    if merge is None or merge.returncode != 0:
        _run_git(path, ["merge", "--abort"])
        return f"  \033[31m⤳ {name}: merge conflict from {upstream_ref}, aborted — resolve manually\033[0m"

    # Push to origin so Claude's plugin update pulls the merged result
    push = _run_git(path, ["push", cfg["origin_remote"], branch, "--quiet"])
    if push is None or push.returncode != 0:
        return (f"  \033[33m⤳ {name}: merged {behind_n} commits locally but push to "
                f"{cfg['origin_remote']} failed (network?)\033[0m")

    return f"  \033[32m✓ {name}: merged {behind_n} upstream commits and pushed to {cfg['origin_remote']}/{branch}\033[0m"


def sync_fork_repos():
    """Sync all configured fork repos. Silent when FORK_SYNC_REPOS is empty or CLAUDE_SKIP_FORK_SYNC is set."""
    if not FORK_SYNC_REPOS:
        return
    if os.environ.get("CLAUDE_SKIP_FORK_SYNC"):
        return
    print("\033[90m[claude-tmux] Checking plugin forks for upstream updates...\033[0m")
    for cfg in FORK_SYNC_REPOS:
        print(sync_one_fork(cfg))


def _agent_fastpath(args):
    """When invoked as a subagent (--agent-id in argv), skip tmux orchestration.

    Claude Code's NeK() resolver reads CLAUDE_CODE_TEAMMATE_COMMAND FIRST to
    choose the teammate spawn binary. On the outer launch we set that env var
    to this wrapper's canonical path, so every subagent spawn re-enters this
    script with `--agent-id …` in argv. We strip `--model <value>` (otherwise
    the subagent caps at 200K instead of defaulting to the 1M variant), then
    exec the real claude ELF via ~/.local/bin/claude.
    """
    if "--agent-id" not in args:
        return
    stripped = []
    skip_next = False
    for a in args:
        if skip_next:
            skip_next = False
            continue
        if a == "--model":
            skip_next = True
            continue
        stripped.append(a)
    os.execv(REAL_CLAUDE, [REAL_CLAUDE] + stripped)


def get_workspace_hash(pwd: str) -> str:
    """Generate short hash from workspace path."""
    return hashlib.md5(pwd.encode()).hexdigest()[:8]


def load_state() -> dict:
    """Load session state from file."""
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except (json.JSONDecodeError, IOError):
            return {"sessions": {}}
    return {"sessions": {}}


def save_state(state: dict):
    """Save session state to file."""
    STATE_FILE.write_text(json.dumps(state, indent=2))


def get_tmux_sessions() -> dict:
    """Get all tmux sessions with their status."""
    result = subprocess.run(
        ["tmux", "ls", "-F", "#{session_name}|#{session_attached}|#{session_created}"],
        capture_output=True,
        text=True
    )
    
    sessions = {}
    if result.returncode == 0:
        for line in result.stdout.strip().split("\n"):
            if line and line.startswith(SESSION_PREFIX):
                parts = line.split("|")
                if len(parts) >= 2:
                    name = parts[0]
                    attached = parts[1] == "1"
                    created = parts[2] if len(parts) > 2 else ""
                    sessions[name] = {
                        "attached": attached,
                        "created": created
                    }
    return sessions


def get_sessions_for_workspace(pwd: str) -> list:
    """Get all sessions matching current workspace."""
    workspace_hash = get_workspace_hash(pwd)
    tmux_sessions = get_tmux_sessions()
    state = load_state()
    
    matching = []
    for name, info in tmux_sessions.items():
        # Check if session belongs to this workspace
        if f"-{workspace_hash}-" in name:
            session_state = state.get("sessions", {}).get(name, {})
            matching.append({
                "name": name,
                "attached": info["attached"],
                "created": info["created"],
                "pwd": session_state.get("pwd", pwd)
            })
    
    return sorted(matching, key=lambda x: x["name"])


def create_new_session(pwd: str) -> str:
    """Create a new tmux session name."""
    workspace_hash = get_workspace_hash(pwd)
    
    # Find next available number
    existing = get_tmux_sessions()
    n = 1
    while f"{SESSION_PREFIX}-{workspace_hash}-{n}" in existing:
        n += 1
    
    session_name = f"{SESSION_PREFIX}-{workspace_hash}-{n}"
    
    # Record in state
    state = load_state()
    state["sessions"][session_name] = {
        "pwd": pwd,
        "created": datetime.now().isoformat()
    }
    save_state(state)
    
    return session_name


def remove_session_from_state(session_name: str):
    """Remove a session from our state file."""
    state = load_state()
    if session_name in state.get("sessions", {}):
        del state["sessions"][session_name]
        save_state(state)


def kill_session(session_name: str):
    """Kill a tmux session."""
    subprocess.run(["tmux", "kill-session", "-t", session_name], capture_output=True)
    remove_session_from_state(session_name)


def attach_session(session_name: str, show_detach_hint: bool = False):
    """Attach to an existing tmux session."""
    if show_detach_hint:
        print("\033[90mTip: Press Ctrl-b d to detach (leaves session running)\033[0m\n")
    # Reload tmux config so any changes apply to this session
    tmux_conf = Path.home() / ".tmux.conf"
    if tmux_conf.exists():
        subprocess.run(["tmux", "source-file", str(tmux_conf)], capture_output=True)

    # Ensure pane-died hook is set (may not exist for older sessions)
    output_file = f"/tmp/claude-tmux-{session_name}.txt"
    subprocess.run([
        "tmux", "set-hook", "-t", session_name, "pane-died",
        f'run-shell "capture-pane -p -S -30 > {output_file}"'
    ], capture_output=True)
    # Attach and track timing
    start_time = time.time()
    subprocess.run(["tmux", "attach", "-t", session_name])
    elapsed = time.time() - start_time

    # If session exited within 10 seconds, show captured output
    if elapsed < 10 and os.path.exists(output_file):
        try:
            content = Path(output_file).read_text().strip()
            if content:
                print("\n\033[1;31m━━━ Session exited quickly. Last output: ━━━\033[0m\n")
                print(content)
                print("\n\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m")
        except IOError:
            pass
    # Clean up temp file
    if os.path.exists(output_file):
        os.remove(output_file)


def start_new_session(session_name: str, args: list):
    """Start a new tmux session with claude (dumb terminal mode)."""
    # Prepend any flags from CLAUDE_TMUX_FLAGS (reads tmux global env if inside tmux)
    env_flags = get_claude_tmux_flags().split()
    all_args = env_flags + args
    cmd = " ".join([REAL_CLAUDE] + all_args)
    cmd = f"echo '[claude-tmux] {cmd}'; {cmd}"

    # Create detached session with the command
    # Claude Code 2.1+ handles scrollback correctly via its own scroll-region
    # rendering (input pinned to bottom, output scrolls cleanly), so CI=true
    # is no longer needed and was actively harmful: it suppressed Claude
    # Code's mouse reporting, which broke the native (blue) selection
    # highlight inside tmux. FORCE_COLOR=1 is kept as a harmless belt-and-braces.

    subprocess.run([
        "tmux", "new-session", "-d", "-s", session_name,
        "-e", "FORCE_COLOR=1",
        "-e", f"CLAUDE_CODE_TEAMMATE_COMMAND={SELF_PATH}",
        cmd
    ], check=True)

    # Disable smcup/rmcup to prevent alternate screen buffer issues
    subprocess.run(["tmux", "set", "-g", "terminal-overrides", "*:smcup@:rmcup@"])



    #------------------------------------------------------------------
    # support for showing last history buffer if it exists straight away 
    #------------------------------------------------------------------

    # Capture last 30 lines to temp file when pane dies (for crash diagnostics)
    output_file = f"/tmp/claude-tmux-{session_name}.txt"
    subprocess.run([
        "tmux", "set-hook", "-t", session_name, "pane-died",
        f'run-shell "capture-pane -p -S -30 > {output_file}"'
    ])


    # Attach and track timing for quick-exit detection
    start_time = time.time()
    subprocess.run(["tmux", "attach", "-t", session_name])
    elapsed = time.time() - start_time

    # If session exited within 10 seconds, show captured output
    if elapsed < 10 and os.path.exists(output_file):
        try:
            content = Path(output_file).read_text().strip()
            if content:
                print("\n\033[1;31m━━━ Session exited quickly. Last output: ━━━\033[0m\n")
                print(content)
                print("\n\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m")
        except IOError:
            pass
    # Clean up temp file
    if os.path.exists(output_file):
        os.remove(output_file)

