SESSION_PREFIX = "cc"
SELF_PATH = str(Path(__file__).resolve())

# Multi-account config. accounts.json lives next to this script.
# .this_claude is a one-word marker recording which account is active.
ACCOUNTS_CONF = Path(SELF_PATH).parent / "accounts.json"
ACTIVE_MARKER = Path(SELF_PATH).parent / ".this_claude"
CLAUDE_DIR = Path.home() / ".claude"

# Per-account slice: these paths inside ~/.claude/ are symlinks to
# ~/.claude-<active-account>/<item>. Everything else in ~/.claude/ stays as
# real shared files visible to both accounts. Keep this list tight — every
# entry here means "this genuinely needs to differ per identity".
PER_ACCOUNT_FILES = [
    ".credentials.json",          # OAuth tokens for the Claude login itself
    "mcp-needs-auth-cache.json",  # tracks which MCPs this account still needs to auth
    "cost-tracker.log",           # per-account cost accounting (user preference)
]
# Ephemeral / continuously-rewritten files that LOSE the symlink race against
# Claude Code's atomic-rename writes. Treating these as symlinks is futile:
# every few minutes Claude rewrites them via write-temp + rename(temp, path),
# which destroys the symlink and leaves a real file containing stale data
# from whichever account wrote last (often the wrong account if any prior
# session is still in memory). Strategy: on --setup, delete these from BOTH
# ~/.claude/ AND HOME so the new account starts fresh and Claude regenerates
# them with correct identity. Accept brief intra-session inaccuracy as the
# tradeoff. Paths can be absolute or relative — relative resolves under HOME.
EPHEMERAL_RESET_ON_SWITCH = [
    Path.home() / ".claude" / "stats-cache.json",  # usage stats — clobbered every few min
    Path.home() / ".claude.json",                   # 62 KB blob in HOME with cached client/usage data
]
PER_ACCOUNT_DIRS = [
    "statsig",                    # feature flags + telemetry keyed by user ID
    "sessions",                   # live session index — keeps resume UI per-account
    "session-env",                # follows sessions/
    "session-data",               # follows sessions/
    "ide",                        # VS Code extension pairing tokens
    "mcp-configs",                # MCP OAuth refresh tokens (account-scoped)
    "homunculus",                 # live background-agent state
    "metrics",                    # per-account metrics
    "telemetry",                  # per-account telemetry buffers
]

# Fork and skill repo sync config lives in forks.json next to this script.
# - fork_sync_repos: forks of Claude Code plugins. On outer launch we fetch
#   upstream, merge into the tracking branch, and push to origin so Claude's
#   own periodic plugin "update" pulls the merged result.
# - skill_sync_repos: upstream-only skill repos — cloned locally and
#   symlinked into ~/.claude/skills/. We don't fork these; just
#   `git pull --ff-only` to keep symlinked skills current.
# Missing/malformed forks.json => both lists empty => sync becomes a no-op.
# See forks.example.json for the schema.
def _load_forks_config() -> tuple[list[dict], list[dict]]:
    conf = Path(SELF_PATH).parent / "forks.json"
    if not conf.exists():
        return [], []
    try:
        data = json.loads(conf.read_text())
    except json.JSONDecodeError as e:
        print(f"\033[33m[claude-tmux] forks.json malformed: {e}; "
              f"fork/skill sync disabled\033[0m", file=sys.stderr)
        return [], []

    def _expand(items):
        out = []
        for item in items:
            entry = dict(item)
            entry["path"] = Path(os.path.expanduser(item["path"]))
            out.append(entry)
        return out

    return (
        _expand(data.get("fork_sync_repos", [])),
        _expand(data.get("skill_sync_repos", [])),
    )


FORK_SYNC_REPOS, SKILL_SYNC_REPOS = _load_forks_config()

def get_claude_tmux_flags() -> str:
    """Get CLAUDE_TMUX_FLAGS, preferring tmux global env when inside tmux.

    The tmux server caches its environment at startup. Shells inside tmux
    inherit this stale snapshot. To work around this, outer invocations
    sync the current value into tmux's global environment, and inner
    invocations read it back from there.
    """
    if os.environ.get("TMUX"):
        result = subprocess.run(
            ["tmux", "show-environment", "-g", "CLAUDE_TMUX_FLAGS"],
            capture_output=True, text=True
        )
        if result.returncode == 0:
            line = result.stdout.strip()
            if "=" in line:
                return line.split("=", 1)[1]
    return os.environ.get("CLAUDE_TMUX_FLAGS", "")


def sync_tmux_flags_to_server():
    """Push current CLAUDE_TMUX_FLAGS into tmux's global environment.

    Called when running outside tmux so that future inside-tmux
    invocations read the up-to-date value via get_claude_tmux_flags().
    """
    val = os.environ.get("CLAUDE_TMUX_FLAGS", "")
    if val:
        subprocess.run(
            ["tmux", "set-environment", "-g", "CLAUDE_TMUX_FLAGS", val],
            capture_output=True
        )
    else:
        # Unset so stale values don't linger
        subprocess.run(
            ["tmux", "set-environment", "-g", "-u", "CLAUDE_TMUX_FLAGS"],
            capture_output=True
        )


def _run_git(path, args, timeout=30):
    """Run git subcommand in repo at `path`. Returns CompletedProcess or None on error."""
    try:
        return subprocess.run(
            ["git", "-C", str(path)] + list(args),
            capture_output=True, text=True, timeout=timeout
        )
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return None


def sync_one_fork(cfg) -> str:
    """Fetch upstream, merge into tracking branch, push to origin. Safe to skip on any problem.

    Returns a one-line status string (already ANSI-coloured) for the caller to print.
    """
    name = cfg["name"]
    path = cfg["path"]
    branch = cfg["branch"]
    upstream_ref = f"{cfg['upstream_remote']}/{cfg['upstream_branch']}"

    if not path.exists() or not (path / ".git").exists():
        return f"  \033[90m⤳ {name}: not a git repo at {path}, skipping\033[0m"

    # Bail cleanly if there's anything uncommitted — don't interfere with user's work
    status = _run_git(path, ["status", "--porcelain"])
    if status is None or status.returncode != 0:
        return f"  \033[31m⤳ {name}: git status failed, skipping\033[0m"
    if status.stdout.strip():
        return f"  \033[33m⤳ {name}: uncommitted changes, skipping\033[0m"

    # Only sync when actually on the tracking branch
    current = _run_git(path, ["rev-parse", "--abbrev-ref", "HEAD"])
    if current is None or current.returncode != 0:
        return f"  \033[31m⤳ {name}: cannot read current branch, skipping\033[0m"
    current_branch = current.stdout.strip()
    if current_branch != branch:
        return f"  \033[33m⤳ {name}: on '{current_branch}' (expected '{branch}'), skipping\033[0m"

    # Fetch upstream (may fail on network — don't block)
    fetch = _run_git(path, ["fetch", cfg["upstream_remote"], "--quiet", "--prune"])
    if fetch is None or fetch.returncode != 0:
        return f"  \033[33m⤳ {name}: fetch upstream failed (offline?), skipping\033[0m"

    behind = _run_git(path, ["rev-list", "--count", f"HEAD..{upstream_ref}"])
    if behind is None or behind.returncode != 0:
        return f"  \033[31m⤳ {name}: cannot compare with {upstream_ref}, skipping\033[0m"
    behind_n = int(behind.stdout.strip() or "0")

    if behind_n == 0:
        return f"  \033[32m✓ {name}: up to date with {upstream_ref}\033[0m"

    # Merge upstream — abort cleanly on conflict
    merge = _run_git(path, ["merge", upstream_ref, "--no-edit", "--quiet"])
    if merge is None or merge.returncode != 0:
        _run_git(path, ["merge", "--abort"])
        return f"  \033[31m⤳ {name}: merge conflict from {upstream_ref}, aborted — resolve manually\033[0m"

    # Push to origin so Claude's plugin update pulls the merged result
    push = _run_git(path, ["push", cfg["origin_remote"], branch, "--quiet"])
    if push is None or push.returncode != 0:
        return (f"  \033[33m⤳ {name}: merged {behind_n} commits locally but push to "
                f"{cfg['origin_remote']} failed (network?)\033[0m")

    return f"  \033[32m✓ {name}: merged {behind_n} upstream commits and pushed to {cfg['origin_remote']}/{branch}\033[0m"


def sync_fork_repos():
    """Sync all configured fork repos. Silent when FORK_SYNC_REPOS is empty or CLAUDE_SKIP_FORK_SYNC is set."""
    if not FORK_SYNC_REPOS:
        return
    if os.environ.get("CLAUDE_SKIP_FORK_SYNC"):
        return
    print("\033[90m[claude-tmux] Checking plugin forks for upstream updates...\033[0m")
    for cfg in FORK_SYNC_REPOS:
        print(sync_one_fork(cfg))


def sync_one_skill(cfg) -> str:
    """Fetch and fast-forward an upstream-only skill repo. Safe to skip on any problem.

    Returns a one-line ANSI-coloured status string for the caller to print.
    """
    name = cfg["name"]
    path = cfg["path"]
    branch = cfg["branch"]
    remote = cfg["remote"]
    remote_ref = f"{remote}/{branch}"

    if not path.exists() or not (path / ".git").exists():
        return f"  \033[90m⤳ {name}: not a git repo at {path}, skipping\033[0m"

    # Bail cleanly if there's anything uncommitted — never touch user's work
    status = _run_git(path, ["status", "--porcelain"])
    if status is None or status.returncode != 0:
        return f"  \033[31m⤳ {name}: git status failed, skipping\033[0m"
    if status.stdout.strip():
        return f"  \033[33m⤳ {name}: uncommitted changes, skipping\033[0m"

    # Only sync when on the expected branch
    current = _run_git(path, ["rev-parse", "--abbrev-ref", "HEAD"])
    if current is None or current.returncode != 0:
        return f"  \033[31m⤳ {name}: cannot read current branch, skipping\033[0m"
    current_branch = current.stdout.strip()
    if current_branch != branch:
        return f"  \033[33m⤳ {name}: on '{current_branch}' (expected '{branch}'), skipping\033[0m"

    # Fetch (may fail offline — non-fatal)
    fetch = _run_git(path, ["fetch", remote, "--quiet", "--prune"])
    if fetch is None or fetch.returncode != 0:
        return f"  \033[33m⤳ {name}: fetch {remote} failed (offline?), skipping\033[0m"

    behind = _run_git(path, ["rev-list", "--count", f"HEAD..{remote_ref}"])
    if behind is None or behind.returncode != 0:
        return f"  \033[31m⤳ {name}: cannot compare with {remote_ref}, skipping\033[0m"
    behind_n = int(behind.stdout.strip() or "0")

    if behind_n == 0:
        return f"  \033[32m✓ {name}: up to date with {remote_ref}\033[0m"

    # Fast-forward only — refuse if local has diverged (preserves any local commits)
    merge = _run_git(path, ["merge", "--ff-only", remote_ref, "--quiet"])
    if merge is None or merge.returncode != 0:
        return f"  \033[33m⤳ {name}: cannot fast-forward from {remote_ref} (local diverged?), skipping\033[0m"

    return f"  \033[32m✓ {name}: pulled {behind_n} commits from {remote_ref}\033[0m"


def sync_skill_repos():
    """Sync all configured skill repos. Silent when SKILL_SYNC_REPOS is empty or CLAUDE_SKIP_SKILL_SYNC is set."""
    if not SKILL_SYNC_REPOS:
        return
    if os.environ.get("CLAUDE_SKIP_SKILL_SYNC"):
        return
    print("\033[90m[claude-tmux] Checking symlinked skill repos for upstream updates...\033[0m")
    for cfg in SKILL_SYNC_REPOS:
        print(sync_one_skill(cfg))


# The ECC plugin's fact-forcing gate (gateguard-fact-force) fires on every
# routine Bash invocation and every first-Edit-per-file, demanding Claude
# quote the user's instruction verbatim. We hate it. We disable it two ways:
#   1. ECC_DISABLED_HOOKS in ~/.claude/settings.json lists both variant IDs
#      (pre:edit-write:gateguard-fact-force and pre:bash:gateguard-fact-force)
#      — the official env-var kill-switch.
#   2. This helper overwrites the backing script with a no-op stub on every
#      outer launch, so the gate stays dead even after a plugin update pulls
#      a fresh copy of the upstream script. Also removes the gateguard skill
#      directory so it stops appearing in the skill listing.
# The stub still exports { run } and still reads/writes stdin cleanly so that
# bash-hook-dispatcher.js (which require()s it) keeps working.
GATEGUARD_STUB = b"""#!/usr/bin/env node
// Neutralized by ./claude wrapper (claude-tmux). Original gate was the
// fact-forcing PreToolUse check; we don't want it. Re-applied on every
// outer launch by neutralize_gateguard() in """ + str(SELF_PATH).encode() + b""".
'use strict';
const run = rawInput => rawInput;
module.exports = { run };
if (require.main === module) {
  let buf = '';
  process.stdin.setEncoding('utf8');
  process.stdin.on('data', c => { buf += c; });
  process.stdin.on('end', () => { process.stdout.write(buf); process.exit(0); });
}
"""


def _ecc_cache_root() -> Path | None:
    """Return the newest ECC plugin version directory, or None if not installed."""
    base = CLAUDE_DIR / "plugins" / "cache" / "everything-claude-code" / "everything-claude-code"
    if not base.is_dir():
        return None
    versions = [p for p in base.iterdir() if p.is_dir()]
    if not versions:
        return None
    # Sort by name — semver-ish dirs like '1.10.0' sort correctly lexically
    # for ECC's numbering, and if they diverge we still pick a deterministic one.
    return sorted(versions, key=lambda p: p.name)[-1]


def neutralize_gateguard():
    """Overwrite the ECC gate script with a no-op stub and remove its skill dir.

    Idempotent, runs on every outer launch. Silent when CLAUDE_SKIP_GATEGUARD_NEUTRALIZE
    is set or ECC isn't installed. Never aborts launch on error — this is belt-and-braces.
    """
    if os.environ.get("CLAUDE_SKIP_GATEGUARD_NEUTRALIZE"):
        return
    root = _ecc_cache_root()
    if root is None:
        return

    script = root / "scripts" / "hooks" / "gateguard-fact-force.js"
    skill_dir = root / "skills" / "gateguard"

    # 1. Stub the backing script (only rewrite if content differs, to avoid
    #    noisy inotify events and keep mtimes stable for ECC's own cache logic)
    if script.parent.is_dir():
        try:
            current = script.read_bytes() if script.exists() else b""
        except OSError:
            current = b""
        if current != GATEGUARD_STUB:
            try:
                script.write_bytes(GATEGUARD_STUB)
                print(f"  \033[32m✓ gateguard script stubbed ({script.relative_to(CLAUDE_DIR)})\033[0m")
            except OSError as e:
                print(f"  \033[33m⤳ could not stub gateguard: {e}\033[0m")

    # 2. Remove the skill directory so the skill stops appearing in listings
    if skill_dir.is_dir():
        try:
            import shutil
            shutil.rmtree(skill_dir)
            print(f"  \033[32m✓ gateguard skill dir removed\033[0m")
        except OSError as e:
            print(f"  \033[33m⤳ could not remove gateguard skill dir: {e}\033[0m")


# ─────────────────────────────────────────────────────────────────────────────
# Multi-account support
#
# ~/.claude/ stays a real directory with all shared state (plugins, skills,
# projects/, CLAUDE.md, etc.). Only the items in PER_ACCOUNT_FILES / _DIRS are
# symlinks out to ~/.claude-<active>/<item>. Switching accounts is just a
# matter of repointing those ~10 symlinks and updating the .this_claude marker.
# ─────────────────────────────────────────────────────────────────────────────

def load_accounts_config() -> dict:
    """Read accounts.json next to this script. Fail loudly if missing/malformed."""
    if not ACCOUNTS_CONF.exists():
        print(f"\033[31m[claude-tmux] Missing {ACCOUNTS_CONF}. "
              f"Create it to use multi-account mode.\033[0m", file=sys.stderr)
        sys.exit(1)
    try:
        return json.loads(ACCOUNTS_CONF.read_text())
    except json.JSONDecodeError as e:
        print(f"\033[31m[claude-tmux] Malformed {ACCOUNTS_CONF}: {e}\033[0m",
              file=sys.stderr)
        sys.exit(1)


def account_dir(cfg: dict, name: str) -> Path:
    """Resolve an account's dir (expanding ~)."""
    return Path(os.path.expanduser(cfg["accounts"][name]["dir"]))


def get_active_account(cfg: dict) -> str:
    """Read active account from .this_claude, falling back to cfg['default']."""
    if ACTIVE_MARKER.exists():
        name = ACTIVE_MARKER.read_text().strip()
        if name in cfg["accounts"]:
            return name
    return cfg["default"]


def _pre_create_slots(adir: Path):
    """Create the account dir plus the per-account directory slots inside it.
    Files are left absent — Claude writes them on first use."""
    adir.mkdir(parents=True, exist_ok=True)
    for d in PER_ACCOUNT_DIRS:
        (adir / d).mkdir(exist_ok=True)


def _atomic_copy(src: Path, dst: Path):
    """Copy src → dst atomically (write-to-temp + rename in dst's dir).
    shutil.copy2 preserves mode AND mtime — both matter: mode for credential
    perms (0o600), mtime for the newer-wins comparison in _sync_file_to_account
    (without preserved mtime, every copy would re-trigger itself next launch)."""
    tmp = dst.parent / (dst.name + ".tmp")
    shutil.copy2(src, tmp)
    tmp.replace(dst)


def _sync_file_to_account(item: str, adir: Path):
    """Snapshot the live ~/.claude/<item> back into the account dir.

    PER_ACCOUNT_FILES are NOT symlinked. Claude Code rewrites them via
    write-temp + rename(temp, path), which destroys symlinks and leaves a
    real file at ~/.claude/<item> (see EPHEMERAL_RESET_ON_SWITCH for the same
    observation about even more frequently-rewritten files). Maintaining the
    symlink invariant is futile; instead we treat ~/.claude/<item> as the
    live working copy and snapshot it back to the account dir on every launch.

    Newer-wins. If ~/.claude/<item> is a stale symlink from an older wrapper
    version, strip it and restore from the snap."""
    live = CLAUDE_DIR / item
    snap = adir / item

    if live.is_symlink():
        # Legacy: previous wrapper symlinked files. Snap is canonical; convert.
        live.unlink()
        if snap.exists():
            _atomic_copy(snap, live)
        return

    if not live.exists():
        # Just after a switch, or user removed it. Restore from snap if any.
        if snap.exists():
            _atomic_copy(snap, live)
        return

    # Live exists as a real file. Snap back if it's newer (or snap is missing).
    if not snap.exists() or live.stat().st_mtime > snap.stat().st_mtime:
        _atomic_copy(live, snap)


def ensure_account_state(cfg: dict, name: str):
    """Reconcile per-account state on every ./claude launch. Idempotent.

    Two strategies, one per kind of slot:

    - PER_ACCOUNT_DIRS: symlinks ~/.claude/<dir> → ~/.claude-<name>/<dir>.
      Claude Code creates individual files inside these dirs but never
      atomic-renames the dir itself, so the symlink survives.

    - PER_ACCOUNT_FILES: NOT symlinked. ~/.claude/<f> is the live working
      copy; this function snapshots it back to the account dir (newer-wins).
      See _sync_file_to_account for the rationale.

    Raises RuntimeError if a dir slot has a real non-empty directory
    conflicting with the account-side — that means a migration was bypassed,
    and --setup handles it."""
    adir = account_dir(cfg, name)
    if not adir.exists():
        raise RuntimeError(
            f"Account dir {adir} does not exist. Run './claude --setup {name}' first."
        )
    _pre_create_slots(adir)

    # Files: snapshot live → account (newer-wins). No symlinks.
    for item in PER_ACCOUNT_FILES:
        _sync_file_to_account(item, adir)

    # Dirs: maintain symlinks. Auto-heal only when account-side is empty.
    for item in PER_ACCOUNT_DIRS:
        target = adir / item
        link = CLAUDE_DIR / item
        expected = str(target)

        if link.is_symlink() and os.readlink(link) == expected:
            continue

        if link.exists() and not link.is_symlink():
            # Real dir at the symlink path. Auto-heal only if account-side is
            # empty/missing; otherwise refuse to guess which copy is canonical.
            target_safe = (
                not target.exists()
                or (target.is_dir() and not any(target.iterdir()))
            )
            if not target_safe:
                raise RuntimeError(
                    f"{link} is a real dir AND {target} also has content. "
                    f"Resolve manually: keep one, delete the other, then re-run."
                )
            if target.exists() and target.is_dir():
                target.rmdir()
            link.rename(target)

        if link.is_symlink():
            link.unlink()
        link.symlink_to(target)


def setup_account(cfg: dict, name: str):
    """Activate `name`. On first use for this account, creates its dir.
    On first run ever (pre-migration), moves real files from ~/.claude/ into
    the active account's slot — that's the one-shot migration path.
    Does NOT launch claude — the caller exits after this."""
    if name not in cfg["accounts"]:
        print(f"\033[31mError: unknown account '{name}'. "
              f"Available: {', '.join(cfg['accounts'])}\033[0m", file=sys.stderr)
        sys.exit(1)

    adir = account_dir(cfg, name)
    first_time = not adir.exists()
    _pre_create_slots(adir)

    # Identify outgoing account so we can preserve its live state before
    # loading the new account's snapshot. None on first-ever migration or
    # when re-running --setup with the currently-active account.
    outgoing = get_active_account(cfg) if ACTIVE_MARKER.exists() else None
    outgoing_adir = account_dir(cfg, outgoing) if outgoing and outgoing != name else None
    if outgoing_adir and not outgoing_adir.exists():
        outgoing_adir = None
    if outgoing_adir:
        _pre_create_slots(outgoing_adir)

    migrated = []

    # Files: save outgoing live state, then load incoming snapshot. No symlinks.
    for item in PER_ACCOUNT_FILES:
        live = CLAUDE_DIR / item
        new_snap = adir / item

        if live.is_symlink():
            # Legacy: older wrapper symlinked files. Snap target already
            # holds the canonical state for the outgoing account; just strip.
            live.unlink()
        elif live.exists():
            if outgoing_adir is not None:
                _atomic_copy(live, outgoing_adir / item)
                migrated.append(f"{item} → saved to {outgoing}")
            else:
                # First-ever migration: live IS the initial snapshot for `name`.
                _atomic_copy(live, new_snap)
                migrated.append(f"{item} → migrated to {name}")
            live.unlink()

        if new_snap.exists():
            _atomic_copy(new_snap, live)
        # else: leave live absent — Claude regenerates on next launch.

    # Dirs: existing symlink swap. Real dir at symlink path = pre-migration
    # state; migrate into THIS account.
    for item in PER_ACCOUNT_DIRS:
        target = adir / item
        link = CLAUDE_DIR / item

        if link.is_symlink():
            link.unlink()
        elif link.exists():
            if target.exists():
                if target.is_dir() and not any(target.iterdir()):
                    target.rmdir()
                else:
                    print(f"\033[31mError: both {link} and {target} exist with "
                          f"content. Resolve manually.\033[0m", file=sys.stderr)
                    sys.exit(1)
            link.rename(target)
            migrated.append(item)

        link.symlink_to(target)

    # Ephemeral files: delete (don't symlink) so the new account starts fresh.
    # See EPHEMERAL_RESET_ON_SWITCH comment for why symlinks lose this race.
    reset = []
    for p in EPHEMERAL_RESET_ON_SWITCH:
        if p.is_symlink() or p.exists():
            try:
                p.unlink()
                reset.append(str(p))
            except OSError as e:
                print(f"\033[33m[warn] could not reset {p}: {e}\033[0m",
                      file=sys.stderr)

    ACTIVE_MARKER.write_text(name + "\n")
    email = cfg["accounts"][name].get("email", "")

    print(f"\n\033[1;32m✓ Active account switched to: {name}\033[0m "
          f"\033[90m({email})\033[0m")
    print(f"  Config dir:    {adir}")
    print(f"  Active marker: {ACTIVE_MARKER}")

    if migrated:
        print(f"\n\033[90m[migrated to {name}]\033[0m")
