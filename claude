    if not sessions:
        print("  \033[90mNo sessions found.\033[0m\n")
        return

    # Group by path
    by_path = {}
    for s in sessions:
        path = s["pwd"]
        if path not in by_path:
            by_path[path] = []
        by_path[path].append(s)

    # Number sequentially in display order
    idx = 1
    for path in sorted(by_path.keys()):
