    print(f"\n\033[90mWorkspace: {pwd}\033[0m\n")

    detached = [s for s in sessions if not s["attached"]]
    attached = [s for s in sessions if s["attached"]]

    idx = 1
    if detached:
        print("\033[1;33m⚡ DETACHED (can reconnect):\033[0m")
